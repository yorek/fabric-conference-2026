{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v1.7.90/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('MSSQL_CONNECTION_STRING')"
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": true
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": true,
      "path": "/mcp",
      "dml-tools": true
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "AppService"
      },
      "mode": "development"
    }
  },
  "entities": {
    "WikipediaArticles": {
      "source": {
        "object": "dbo.WikipediaArticles",
        "type": "table"
      },
      "fields": [
        {
          "name": "id",
          "description": "Unique identifier for each article",
          "primary-key": true
        },
        {
          "name": "url",
          "description": "Title of the article",
          "primary-key": false
        },
        {
          "name": "title",
          "description": "Title of the article",
          "primary-key": false
        },
        {
          "name": "text",
          "description": "The content of the article",
          "primary-key": false
        }
      ],
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "WikipediaArticles",
          "plural": "WikipediaArticles"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    },
    "WikipediaArticlesSearch": {
      "source": {
        "object": "dbo.WikipediaArticlesSearch",
        "type": "stored-procedure",
        "parameters": [
          {
            "name": "text",
            "required": false,
            "description": "regular expression used to find the desired content"
          }
        ]
      },
       "fields": [
        {
          "name": "id",
          "description": "Unique identifier for each article",
          "primary-key": true
        },
        {
          "name": "url",
          "description": "Title of the article",
          "primary-key": false
        },
        {
          "name": "title",
          "description": "Title of the article",
          "primary-key": false
        },
        {
          "name": "text",
          "description": "The content of the article",
          "primary-key": false
        }
      ],
      "graphql": {
        "enabled": true,
        "operation": "query",
        "type": {
          "singular": "WikipediaArticlesSearch",
          "plural": "WikipediaArticlesSearches"
        }
      },
      "rest": {
        "enabled": true,
        "methods": [
          "post"
        ]
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    }
  }
}